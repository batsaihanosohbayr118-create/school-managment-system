{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "channel": "development",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://www.nova-edu.mn",
        "EXPO_PUBLIC_WEB_ADMIN_URL": "https://www.nova-edu.mn/admin/dashboard"
      }
    },
    "preview": {
      "channel": "preview",
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://www.nova-edu.mn",
        "EXPO_PUBLIC_WEB_ADMIN_URL": "https://www.nova-edu.mn/admin/dashboard"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://www.nova-edu.mn",
        "EXPO_PUBLIC_WEB_ADMIN_URL": "https://www.nova-edu.mn/admin/dashboard"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6800562728",
        "appleTeamId": "RQL8N4ADLL"
      }
    }
  }
}
