# --- PostgreSQL (school resource APIs) ---
DATABASE_URL=postgresql://user:password@host:5432/postgres
# Use this for hosted PostgreSQL providers that require SSL.
DATABASE_SSL=true

# --- Supabase Auth (login + session) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=

# --- Admin user provisioning (server-only, NEVER expose with NEXT_PUBLIC_) ---
# Required so an admin can create/edit/delete/reset accounts from
# /admin/users via the Supabase Admin API. Without it that screen shows a
# setup notice and provisioning stays disabled.
SUPABASE_SERVICE_ROLE_KEY=

# --- QPay (mobile app payments; server-only, NEVER expose with NEXT_PUBLIC_/EXPO_PUBLIC_) ---
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=
# Sandbox: https://merchant-sandbox.qpay.mn
QPAY_BASE_URL=https://merchant.qpay.mn
# Public origin QPay calls back after payment (QPay cannot reach localhost).
QPAY_CALLBACK_BASE_URL=https://www.nova-edu.mn
# Optional; signs check tokens and callback URLs. Falls back to QPAY_PASSWORD.
QPAY_SIGNING_SECRET=
